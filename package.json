{
  "name": "aaron-ai-chat",
  "version": "1.0.0",
  "description": "A lightweight, responsive AI chat application by Aaron Lee F. Angeles. Vanilla JS frontend, Express + OpenAI SDK backend with SSE streaming.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "test:unit": "node --test tests/config.test.js",
    "test:integration": "node --test tests/integration.test.js",
    "test:watch": "node --test --watch",
    "lint": "eslint server.js public/app.js tests eslint.config.js --max-warnings=71",
    "lint:fix": "eslint --fix server.js public/app.js tests eslint.config.js",
    "docker:build": "docker build -t aaron-ai-chat:local .",
    "docker:run": "docker run --rm --init -p 3000:3000 --env-file .env aaron-ai-chat:local",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "ai",
    "chat",
    "openai",
    "sse",
    "streaming",
    "express",
    "vanilla-js"
  ],
  "author": "Aaron Lee F. Angeles",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "8.7.0",
    "helmet": "^7.1.0",
    "openai": "^4.67.3"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "globals": "15.15.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
