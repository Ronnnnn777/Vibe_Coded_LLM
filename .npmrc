# ============================================================
# npm configuration for Aaron AI Chat
# Author: Aaron Lee F. Angeles
# ============================================================

# Always save exact versions in package.json (no ^ or ~ ranges).
# This makes lockfile more reproducible across machines.
save-exact=true

# Always generate a package-lock.json (do NOT use --no-package-lock).
# The lockfile MUST be committed so CI gets consistent installs.
package-lock=true

# NOTE: do NOT set `omit=dev` here. It applies to EVERY install, including
# `npm ci` in CI, which silently strips ESLint/test tooling and makes the
# lint job fail with "command not found". Production images ask for it
# explicitly instead: `npm ci --omit=dev` (see Dockerfile).

# Skip scripts in postinstall/test/prepare hooks during CI builds.
# Prevents malicious postinstall scripts from node_modules.
# In local dev, scripts run normally.
# This is ignored on `npm run` scripts.
ignore-scripts=false

# Preferred package manager (speed hint for tooling).
engine-strict=true