# ============================================================
# AI Chat App - Environment Configuration
# Copied by: Aaron Lee F. Angeles
#
# 1. Copy this file to ".env"
# 2. Fill in your real API key below
# 3. The .env file is loaded ONLY on the server and is never
#    exposed to the browser. Do NOT commit the real .env file.
# ============================================================

# The secret API key for the Dahl Inference provider.
# NEVER commit this value. Keep it in .env only.
OPENAI_API_KEY=sk-your-secret-api-key-here

# Base URL of the Dahl Inference OpenAI-compatible provider.
OPENAI_BASE_URL=https://inference.dahl.global/v1

# The model identifier used for chat completions.
OPENAI_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731

# Port the Express server listens on.
PORT=3000

# ── Deployment / security ──────────────────────────────────────────────

# Your production deployment URL (e.g. https://aaron-ai-chat.vercel.app).
# Used to restrict CORS to only your deployed origin. Leave empty locally.
APP_URL=

# Optional shared secret — if set, /api/chat requires this exact value
# in the `x-shared-secret` HTTP header (returns 401 otherwise).
# NOTE: browser secrets are visible in page source. For private single-user
# access, prefer Vercel Password Protection instead (see README).
# Leave empty to disable this check.
SHARED_SECRET=
